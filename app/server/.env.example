# =============================================================================
# MindAccel Tutoring API — environment configuration
# Copy to .env (chmod 600) and fill in. Every value is validated at boot by
# src/config/env.ts; the server refuses to start if something is wrong.
# =============================================================================

NODE_ENV=production
# Port the app listens on (localhost only; nginx forwards to it).
PORT=3105
HOST=127.0.0.1

# Public URL of the site, with the install path if any and NO trailing slash.
# e.g. https://app.mindaccel.org   or   https://mindaccel.org/tutoring
APP_URL=https://app.mindaccel.org

# --- Database (created by YunoHost: sudo yunohost app setting mindaccel db_pwd) -
DATABASE_URL=postgresql://mindaccel:CHANGE_ME@localhost:5432/mindaccel?schema=public

# --- Auth --------------------------------------------------------------------
# Generate with:  openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MIN=60
INVITE_TTL_HOURS=72
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- Google SMTP -------------------------------------------------------------
# Gmail / Google Workspace with 2-Step Verification + an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=notifications@mindaccel.org
SMTP_PASS=xxxxxxxxxxxxxxxx
MAIL_FROM="MindAccel Tutoring <notifications@mindaccel.org>"
# Set to false in dev to log emails instead of sending them.
EMAIL_ENABLED=true

# --- Scheduling rules --------------------------------------------------------
BOOKING_MIN_LEAD_HOURS=12
BOOKING_MAX_HORIZON_DAYS=60
BOOKING_SLOT_STEP_MIN=15
STUDENT_CANCEL_CUTOFF_HOURS=24
# Send the tutor a "please post the link" nudge this many minutes before start.
MEETING_LINK_NUDGE_MIN=15

# --- Resource Hub ------------------------------------------------------------
# Kept outside the install folder so upgrades never touch it. Files are only served via the API.
UPLOAD_DIR=/home/yunohost.app/mindaccel/uploads

# The built web app (the Node service serves it itself).
CLIENT_DIST_DIR=/var/www/mindaccel/client/dist
UPLOAD_MAX_MB=25

# --- Bootstrap admin (used by `mindaccel create-admin`) -------------------------
SEED_ADMIN_EMAIL=gabez@mindaccel.org
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=MindAccel

LOG_LEVEL=info
