{
  "name": "@mindaccel/server",
  "version": "4.1.0",
  "private": true,
  "description": "MindAccel Tutoring (free) (Express 5 + Prisma + PostgreSQL) \u2014 runs as its own YunoHost app",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:new-migration": "prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --script",
    "db:studio": "prisma studio",
    "admin:create": "node --env-file=.env dist/cli/create-admin.js",
    "test": "node --env-file=.env.test --import tsx --test \"src/**/*.test.ts\"",
    "admin:verify": "node --env-file=.env dist/cli/verify-data.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.0",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.0",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "prisma": "^6.19.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.1",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.0",
    "pino-pretty": "^13.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
