// =============================================================================
// MindAccel Tutoring — Prisma data model (source of truth for the app layer)
// -----------------------------------------------------------------------------
// Conventions
//   * Tables and columns are snake_case in PostgreSQL (@@map / @map) so the DB
//     stays pleasant to query by hand; models/fields are PascalCase/camelCase.
//   * Every timestamp is TIMESTAMPTZ and stored in UTC. Timezone conversion
//     happens only at the edges (slot generation + UI rendering).
//   * UUID primary keys are generated by PostgreSQL (gen_random_uuid()).
//   * Constraints Prisma cannot express (exclusion constraints that make
//     double-booking impossible, CHECK constraints) live in the SQL migration
//     prisma/migrations/0001_init/migration.sql — keep both in sync.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

/// Lifecycle of an account. New student self-registrations start as PENDING
/// and cannot sign in until an admin approves them.
enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

/// Lifecycle: PENDING (requested, holds the slot) → CONFIRMED by the tutor
/// (or DECLINED) → started/ended (timestamps) → COMPLETED / NO_SHOW.
/// CANCELLED can happen from PENDING or CONFIRMED.
enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
  DECLINED
}

/// HISTORY ONLY (v4.1+: everything is free, new bookings are always NOT_REQUIRED).
/// How a booking was paid for when the site still charged for sessions.
enum BookingPayment {
  NOT_REQUIRED // free service, payments off, or booked by staff
  AWAITING_PAYMENT // student is at Stripe Checkout; the slot is held until holdExpiresAt
  PAID // paid by card for this session
  REFUNDED // card payment refunded (declined / cancelled / expired)
  CREDIT_USED // one session credit from a package was used
  CREDIT_RETURNED // that credit was given back
  INCLUDED_IN_PLAN // covered by an active subscription
}

enum PaymentKind {
  SESSION
  PACKAGE
  SUBSCRIPTION
}

enum ResourceType {
  FILE // uploaded file stored on disk (PDF, DOCX, ...)
  LINK // any external URL
  VIDEO // external video URL (YouTube, Drive, Vimeo, ...)
}

enum ReportCategory {
  SAFETY
  CONDUCT
  NO_SHOW
  QUALITY
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

/// SHARED = the student can read it too; TUTORS_ONLY = tutors and admins only.
enum NoteVisibility {
  SHARED
  TUTORS_ONLY
}

/// MESSAGE = ordinary chat; QUESTION = a tutor's question about an upcoming session,
/// highlighted for the student until they answer it.
enum MessageKind {
  MESSAGE
  QUESTION
}

enum FeedPostKind {
  MEETING_LINK
  NOTE
  SYSTEM
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum BillingInterval {
  ONE_TIME
  MONTH
  YEAR
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// -----------------------------------------------------------------------------
// Identity & access
// -----------------------------------------------------------------------------

model User {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Always stored lower-cased (normalised in the service layer).
  email            String     @unique
  passwordHash     String?    @map("password_hash") // null until an invited user sets a password
  firstName        String     @map("first_name")
  lastName         String     @map("last_name")
  /// IANA timezone, e.g. "America/Chicago". Drives how times are shown/emailed.
  timezone         String     @default("UTC")
  status           UserStatus @default(PENDING)
  approvedAt       DateTime?  @map("approved_at") @db.Timestamptz(3)
  approvedById     String?    @map("approved_by_id") @db.Uuid
  rejectionReason  String?    @map("rejection_reason")
  lastLoginAt      DateTime?  @map("last_login_at") @db.Timestamptz(3)
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockedUntil      DateTime?  @map("locked_until") @db.Timestamptz(3)
  /// Bumping this invalidates every outstanding access token for the user.
  tokenVersion     Int        @default(0) @map("token_version")
  /// Set when an admin deletes an account that has history to keep; personal
  /// data is scrubbed and the row only remains as "Deleted user".
  deletedAt        DateTime?  @map("deleted_at") @db.Timestamptz(3)
  /// Stripe customer id (cus_...), created on first purchase.
  stripeCustomerRef String?   @unique @map("stripe_customer_ref")
  /// A visitor who booked without an account (Settings → "Account needed to book" off).
  /// Guests have no password and can never sign in; they manage a booking through the
  /// signed link in their emails. Registering with the same email later turns the guest
  /// into a normal account and keeps their booking history.
  isGuest          Boolean    @default(false) @map("is_guest")
  /// Set when the person finishes or skips the welcome tour; null shows it at next sign-in.
  tourCompletedAt  DateTime?  @map("tour_completed_at") @db.Timestamptz(3)
  /// Email preferences (Profile → Notifications). Account and booking emails always send.
  emailOnMessage   Boolean    @default(true) @map("email_on_message")
  emailReminders   Boolean    @default(true) @map("email_reminders")
  /// Secret part of the personal calendar feed URL; reset it to invalidate old links.
  calendarKey      String?    @map("calendar_key")
  /// When and which version of the Terms & Privacy Policy the person last accepted.
  /// A version that differs from Settings → Legal asks them to accept again.
  termsAcceptedAt  DateTime?  @map("terms_accepted_at") @db.Timestamptz(3)
  termsVersion     String?    @map("terms_version")
  /// The person confirmed a parent or guardian agreed on their behalf (under-age sign-ups).
  guardianConsent  Boolean    @default(false) @map("guardian_consent")
  /// Set when the person asks (Profile → Your data) for their account to be deleted.
  deletionRequestedAt DateTime? @map("deletion_requested_at") @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  approvedBy User?  @relation("UserApprovals", fields: [approvedById], references: [id], onDelete: SetNull)
  approvals  User[] @relation("UserApprovals")

  roles               UserRole[]           @relation("UserRoleUser")
  rolesAssigned       UserRole[]           @relation("UserRoleAssigner")
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  settingsUpdated     AppSetting[]

  tutorServices          TutorService[]
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  bookingsAsStudent      Booking[]              @relation("StudentBookings")
  bookingsAsTutor        Booking[]              @relation("TutorBookings")
  bookingsCancelled      Booking[]              @relation("BookingCanceller")
  feedPosts              SessionFeedPost[]

  groupsOwned         Group[]
  groupMemberships    GroupMember[]
  resources           Resource[]
  resourceAssignments ResourceAssignment[] @relation("AssignmentStudent")
  assignmentsMade     ResourceAssignment[] @relation("AssignmentAssigner")
  packetsUploaded     StudyPacket[]

  conversationsAsStudent Conversation[] @relation("ConversationStudent")
  conversationsAsTutor   Conversation[] @relation("ConversationTutor")
  messagesSent           Message[]
  feedbackGiven          SessionFeedback[]
  reportsAbout           TutorReport[]    @relation("ReportTutor")
  reportsFiled           TutorReport[]    @relation("ReportReporter")
  reportsHandled         TutorReport[]    @relation("ReportHandler")
  notesAbout             StudentNote[]    @relation("NoteStudent")
  notesWritten           StudentNote[]    @relation("NoteAuthor")

  subscriptions  Subscription[]
  payments       Payment[]
  credits        SessionCredit[] @relation("CreditOwner")
  creditsGranted SessionCredit[] @relation("CreditGranter")

  @@index([status])
  @@map("users")
}

/// A role is a named bundle of permissions. System roles (admin/tutor/student)
/// cannot be deleted; admins can create any number of custom roles.
model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stable machine key, e.g. "admin", "tutor", "parent-observer".
  key         String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

/// Rows are synced from the code catalog (src/modules/rbac/permissions.ts) on
/// every boot, so adding a permission in code makes it selectable in the UI.
model Permission {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// "resource:action", e.g. "bookings:create".
  key         String  @unique
  category    String
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Users may hold several roles; effective permissions are the union.
model UserRole {
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  assignedById String?  @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  user       User  @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("UserRoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Opaque refresh tokens (only a SHA-256 hash is stored). Rotated on every use;
/// re-use of an already-rotated token revokes the whole family (theft detection).
model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  familyId   String    @map("family_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedAt DateTime? @map("replaced_at") @db.Timestamptz(3)
  userAgent  String?   @map("user_agent")
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Used for both "forgot password" and "set your password" invitations.
model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String // e.g. "user.approved", "role.updated"
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// Scheduling
// -----------------------------------------------------------------------------

/// A bookable offering, e.g. "SAT Math — 60 min".
model Service {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  description     String?
  durationMinutes Int      @map("duration_minutes")
  /// Gap enforced after a session before the tutor's next booking.
  bufferMinutes   Int      @default(0) @map("buffer_minutes")
  isActive        Boolean  @default(true) @map("is_active")
  /// HISTORY ONLY: price from when the site charged for sessions. Not used or shown.
  priceCents      Int?     @map("price_cents")
  currency        String   @default("USD")
  /// Soft delete: set when a service with booking history is deleted.
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tutors        TutorService[]
  bookings      Booking[]
  plans         Plan[]
  creditEntries SessionCredit[]

  @@map("services")
}

/// Which tutors deliver which services.
model TutorService {
  tutorId   String @map("tutor_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid

  tutor   User    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([tutorId, serviceId])
  @@index([serviceId])
  @@map("tutor_services")
}

/// Weekly recurring availability, expressed in the tutor's own timezone
/// (wall-clock minutes since midnight) so DST shifts are handled correctly.
model AvailabilityRule {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tutorId       String    @map("tutor_id") @db.Uuid
  /// ISO weekday: 1 = Monday ... 7 = Sunday (matches Luxon).
  weekday       Int
  startMinute   Int       @map("start_minute") // 0..1439
  endMinute     Int       @map("end_minute") // 1..1440
  timezone      String
  effectiveFrom DateTime? @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tutor User @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId, weekday])
  @@map("availability_rules")
}

/// One-off overrides: blackouts (isAvailable=false) or extra hours (true).
model AvailabilityException {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tutorId     String   @map("tutor_id") @db.Uuid
  startsAt    DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime @map("ends_at") @db.Timestamptz(3)
  isAvailable Boolean  @default(false) @map("is_available")
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tutor User @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId, startsAt])
  @@map("availability_exceptions")
}

/// A booked session. The SQL migration adds exclusion constraints so the same
/// tutor (or student) can never hold two overlapping active bookings, even
/// under concurrent requests.
model Booking {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId          String        @map("student_id") @db.Uuid
  tutorId            String        @map("tutor_id") @db.Uuid
  serviceId          String        @map("service_id") @db.Uuid
  startsAt           DateTime      @map("starts_at") @db.Timestamptz(3)
  /// End of the session itself.
  endsAt             DateTime      @map("ends_at") @db.Timestamptz(3)
  /// endsAt + service buffer; used for overlap checks.
  blockedUntil       DateTime      @map("blocked_until") @db.Timestamptz(3)
  status             BookingStatus @default(PENDING)
  studentNotes       String?       @map("student_notes")
  meetingUrl         String?       @map("meeting_url")
  /// The tutor's summary after the session: what was covered, homework.
  recap         String?
  recapPostedAt DateTime? @map("recap_posted_at") @db.Timestamptz(3)
  meetingPostedAt    DateTime?     @map("meeting_posted_at") @db.Timestamptz(3)
  confirmedAt        DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  /// Tutors may start early and end early; these record what actually happened.
  startedAt          DateTime?     @map("started_at") @db.Timestamptz(3)
  endedAt            DateTime?     @map("ended_at") @db.Timestamptz(3)
  cancelledAt        DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelledById      String?       @map("cancelled_by_id") @db.Uuid
  /// Reason given when cancelled or declined (shown to the other person).
  cancelReason       String?       @map("cancel_reason")
  reminder24hSentAt  DateTime?     @map("reminder_24h_sent_at") @db.Timestamptz(3)
  reminder1hSentAt   DateTime?     @map("reminder_1h_sent_at") @db.Timestamptz(3)
  linkNudgeSentAt    DateTime?     @map("link_nudge_sent_at") @db.Timestamptz(3)
  payment            BookingPayment @default(NOT_REQUIRED)
  /// Price charged for this booking (pay-per-session), in the smallest currency unit.
  priceCents         Int?          @map("price_cents")
  currency           String?
  /// While AWAITING_PAYMENT: when the held slot is released.
  holdExpiresAt      DateTime?     @map("hold_expires_at") @db.Timestamptz(3)
  /// Stripe Checkout Session id (cs_...) for pay-per-session.
  checkoutRef        String?       @unique @map("checkout_ref")
  subscriptionId     String?       @map("subscription_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  student     User              @relation("StudentBookings", fields: [studentId], references: [id], onDelete: Restrict)
  tutor       User              @relation("TutorBookings", fields: [tutorId], references: [id], onDelete: Restrict)
  service     Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  cancelledBy User?             @relation("BookingCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  feedPosts     SessionFeedPost[]
  payments      Payment[]
  subscription  Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  creditEntries SessionCredit[]
  messages      Message[]
  feedback      SessionFeedback?
  reports       TutorReport[]

  @@index([tutorId, startsAt])
  @@index([studentId, startsAt])
  @@index([status, startsAt])
  @@map("bookings")
}

/// Timeline entries for the Session Feed (meeting links, notes, system events).
model SessionFeedPost {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId  String       @map("booking_id") @db.Uuid
  authorId   String?      @map("author_id") @db.Uuid
  kind       FeedPostKind
  message    String?
  meetingUrl String?      @map("meeting_url")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@map("session_feed_posts")
}

// -----------------------------------------------------------------------------
// Classes (groups) & Resource Hub
// -----------------------------------------------------------------------------

/// A class/cohort of students, owned by a tutor.
model Group {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  ownerId     String   @map("owner_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner       User                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  members     GroupMember[]
  assignments ResourceAssignment[]

  @@index([ownerId])
  @@map("groups")
}

model GroupMember {
  groupId  String   @map("group_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

model Resource {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId      String       @map("owner_id") @db.Uuid
  title        String
  description  String?
  type         ResourceType
  /// Free-form folder path for organisation, e.g. "Algebra/Unit 3".
  folder       String?
  tags         String[]     @default([])
  url          String? // LINK / VIDEO
  storageKey   String?      @map("storage_key") // FILE: random name on disk
  originalName String?      @map("original_name")
  mimeType     String?      @map("mime_type")
  sizeBytes    Int?         @map("size_bytes")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner       User                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  assignments ResourceAssignment[]

  @@index([ownerId])
  @@map("resources")
}

/// A resource is assigned to exactly one target: a student OR a group
/// (enforced by a CHECK constraint in SQL).
model ResourceAssignment {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resourceId   String    @map("resource_id") @db.Uuid
  studentId    String?   @map("student_id") @db.Uuid
  groupId      String?   @map("group_id") @db.Uuid
  assignedById String?   @map("assigned_by_id") @db.Uuid
  dueAt        DateTime? @map("due_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  student    User?    @relation("AssignmentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  group      Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  assignedBy User?    @relation("AssignmentAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([resourceId, studentId])
  @@unique([resourceId, groupId])
  @@index([studentId])
  @@index([groupId])
  @@map("resource_assignments")
}

// -----------------------------------------------------------------------------
// Messaging: one private thread per student–tutor pair
// -----------------------------------------------------------------------------

/// Read and email state is stored per side, so unread counts and "one email per
/// unread streak" need no extra table.
model Conversation {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId         String    @map("student_id") @db.Uuid
  tutorId           String    @map("tutor_id") @db.Uuid
  lastMessageAt     DateTime  @default(now()) @map("last_message_at") @db.Timestamptz(3)
  studentLastReadAt DateTime? @map("student_last_read_at") @db.Timestamptz(3)
  tutorLastReadAt   DateTime? @map("tutor_last_read_at") @db.Timestamptz(3)
  /// When each side was last emailed about this thread (throttles notifications).
  studentNotifiedAt DateTime? @map("student_notified_at") @db.Timestamptz(3)
  tutorNotifiedAt   DateTime? @map("tutor_notified_at") @db.Timestamptz(3)
  /// Each side can archive (close) the thread for themselves; a new message reopens it.
  studentArchivedAt DateTime? @map("student_archived_at") @db.Timestamptz(3)
  tutorArchivedAt   DateTime? @map("tutor_archived_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  student  User      @relation("ConversationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  tutor    User      @relation("ConversationTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([studentId, tutorId])
  @@index([tutorId, lastMessageAt])
  @@index([studentId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  senderId       String      @map("sender_id") @db.Uuid
  kind           MessageKind @default(MESSAGE)
  body           String
  /// The session a question (or an answer to it) is about.
  bookingId      String?     @map("booking_id") @db.Uuid
  /// Set on an answer: the question it answers.
  replyToId      String?     @map("reply_to_id") @db.Uuid
  /// Set on a QUESTION once the student answers it.
  answeredAt     DateTime?   @map("answered_at") @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  booking      Booking?     @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  replyTo      Message?     @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("MessageReply")

  @@index([conversationId, createdAt])
  @@index([bookingId])
  @@map("messages")
}

/// A student's rating of a finished session (one per session, editable for 14 days).
model SessionFeedback {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId String   @unique @map("booking_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  rating    Int      @db.SmallInt
  comment   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("session_feedback")
}

/// A report about a tutor, reviewed by admins with safety:manage.
model TutorReport {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tutorId     String         @map("tutor_id") @db.Uuid
  reporterId  String         @map("reporter_id") @db.Uuid
  bookingId   String?        @map("booking_id") @db.Uuid
  category    ReportCategory
  details     String
  status      ReportStatus   @default(OPEN)
  /// Internal note by the admin handling it; never shown to the reporter or tutor.
  adminNote   String?        @map("admin_note")
  handledById String?        @map("handled_by_id") @db.Uuid
  handledAt   DateTime?      @map("handled_at") @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  tutor     User     @relation("ReportTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  reporter  User     @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  handledBy User?    @relation("ReportHandler", fields: [handledById], references: [id], onDelete: SetNull)
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([tutorId])
  @@map("tutor_reports")
}

/// A tutor's note about a student. Every tutor can read it; SHARED notes are also shown to the student.
model StudentNote {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId  String         @map("student_id") @db.Uuid
  authorId   String         @map("author_id") @db.Uuid
  body       String
  visibility NoteVisibility @default(TUTORS_ONLY)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  student User @relation("NoteStudent", fields: [studentId], references: [id], onDelete: Cascade)
  author  User @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@map("student_notes")
}

// -----------------------------------------------------------------------------
// Free study packets (public page /packets, managed in Admin → Study packets)
// -----------------------------------------------------------------------------

/// A downloadable practice packet that anyone can get without an account.
/// Files live in UPLOAD_DIR like Resource Hub files and are only served by the API.
model StudyPacket {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String
  description   String?
  /// Subject heading on the public page, e.g. "ACT Math". Usually a service name.
  subject       String
  /// Optional, shown to visitors ("7 pages").
  pageCount     Int?     @map("page_count")
  storageKey    String   @map("storage_key")
  originalName  String   @map("original_name")
  mimeType      String   @map("mime_type")
  sizeBytes     Int      @map("size_bytes")
  /// Hidden packets stay in the admin list but are not shown or downloadable publicly.
  isPublished   Boolean  @default(true) @map("is_published")
  /// Lower numbers are listed first within a subject.
  sortOrder     Int      @default(0) @map("sort_order")
  downloadCount Int      @default(0) @map("download_count")
  /// Set for packets that ship with the app (seeded once on first start).
  seedKey       String?  @unique @map("seed_key")
  createdById   String?  @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isPublished, subject])
  @@map("study_packets")
}

// -----------------------------------------------------------------------------
// Site settings (branding etc.) — small JSON documents keyed by name
// -----------------------------------------------------------------------------

model AppSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("app_settings")
}

// -----------------------------------------------------------------------------
// Email outbox (reliable, retryable delivery via Google SMTP)
// -----------------------------------------------------------------------------

model EmailOutbox {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  toEmail   String      @map("to_email")
  template  String // key into src/modules/email/templates
  payload   Json
  status    EmailStatus @default(PENDING)
  attempts  Int         @default(0)
  lastError String?     @map("last_error")
  sendAfter DateTime    @default(now()) @map("send_after") @db.Timestamptz(3)
  sentAt    DateTime?   @map("sent_at") @db.Timestamptz(3)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, sendAfter])
  @@map("email_outbox")
}

// -----------------------------------------------------------------------------
// HISTORY ONLY — payments (removed in v4.1, everything is free now).
// These tables are kept, untouched, so past payments, plans, subscriptions and
// credits are never lost. Nothing in the app reads or writes them any more,
// except that deleting an account keeps a scrubbed "Deleted user" row when the
// person has payment history (the foreign keys require it).
// -----------------------------------------------------------------------------

model Plan {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key              String          @unique // e.g. "monthly-4-sessions"
  name             String
  description      String?
  priceCents       Int             @map("price_cents")
  currency         String          @default("USD")
  interval         BillingInterval
  /// Entitlement keys this plan grants, e.g. ["sessions.book", "resources.premium"].
  features         Json            @default("[]")
  /// Provider-side identifier (Stripe price id, PayPal plan id).
  providerPriceRef String?         @map("provider_price_ref")
  /// Stripe product id; created automatically when the plan is saved.
  providerProductRef String?       @map("provider_product_ref")
  /// Packages (interval ONE_TIME): how many session credits the purchase adds.
  sessionCredits   Int?            @map("session_credits")
  /// Subscriptions: sessions included per billing period (null = unlimited).
  sessionsPerPeriod Int?           @map("sessions_per_period")
  /// Limit to one service (null = any service).
  serviceId        String?         @map("service_id") @db.Uuid
  isActive         Boolean         @default(true) @map("is_active")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  service       Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  subscriptions Subscription[]
  payments      Payment[]

  @@map("plans")
}

model Subscription {
  id                      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String             @map("user_id") @db.Uuid
  planId                  String             @map("plan_id") @db.Uuid
  status                  SubscriptionStatus
  provider                String // "none" | "stripe" | "paypal" | "manual"
  providerCustomerRef     String?            @map("provider_customer_ref")
  providerSubscriptionRef String?            @unique @map("provider_subscription_ref")
  currentPeriodStart      DateTime?          @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd        DateTime?          @map("current_period_end") @db.Timestamptz(3)
  cancelAtPeriodEnd       Boolean            @default(false) @map("cancel_at_period_end")
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan     Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments Payment[]
  bookings Booking[]

  @@index([userId, status])
  @@map("subscriptions")
}

model Payment {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String        @map("user_id") @db.Uuid
  subscriptionId     String?       @map("subscription_id") @db.Uuid
  bookingId          String?       @map("booking_id") @db.Uuid
  amountCents        Int           @map("amount_cents")
  currency           String        @default("USD")
  status             PaymentStatus @default(PENDING)
  provider           String
  providerPaymentRef String?       @unique @map("provider_payment_ref")
  kind               PaymentKind   @default(SESSION)
  planId             String?       @map("plan_id") @db.Uuid
  /// What was bought, e.g. "SAT Math, Thu Oct 15" or "5-session package".
  description        String?
  receiptUrl         String?       @map("receipt_url")
  refundedCents      Int           @default(0) @map("refunded_cents")
  refundRef          String?       @map("refund_ref")
  /// Set when a refund is owed but Stripe could not be reached; a job retries.
  refundRequestedAt  DateTime?     @map("refund_requested_at") @db.Timestamptz(3)
  refundedAt         DateTime?     @map("refunded_at") @db.Timestamptz(3)
  metadata           Json?
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  booking       Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  plan          Plan?           @relation(fields: [planId], references: [id], onDelete: SetNull)
  creditEntries SessionCredit[]

  @@index([userId, createdAt])
  @@map("payments")
}

/// Session-credit ledger: +N when a package is bought or credits are gifted,
/// -1 when a booking uses one, +1 when that booking is declined/cancelled.
/// Balance = SUM(delta). A partial unique index (SQL) stops a booking from
/// using two credits.
model SessionCredit {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  delta       Int
  /// Credits from a service-specific package only work for that service.
  serviceId   String?  @map("service_id") @db.Uuid
  bookingId   String?  @map("booking_id") @db.Uuid
  paymentId   String?  @map("payment_id") @db.Uuid
  reason      String
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User     @relation("CreditOwner", fields: [userId], references: [id], onDelete: Cascade)
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("CreditGranter", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("session_credits")
}

/// Webhook idempotency log: every provider event is stored once by its id.
model BillingEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider    String
  eventId     String    @map("event_id")
  type        String
  payload     Json
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@map("billing_events")
}
